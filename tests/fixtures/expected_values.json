    "price_decimals": 6,
    "size_decimals": 8,
    "initial_margin_min": "0.01",
    "initial_margin_max": "0.50"
  },
  
  "liquidation_test_cases": [
    {
      "description": "Standard long position",
      "entry_price": "100.0",
      "size": "10.0",
      "deposit": "100.0",
      "type": "Long",
      "maintenance_margin": "0.05",
      "expected_liquidation_price": "95.0",
      "expected_bankruptcy_price": "90.0"
    },
    {
      "description": "Standard short position",
      "entry_price": "100.0",
      "size": "10.0",
      "deposit": "100.0",
      "type": "Short",
      "maintenance_margin": "0.05",
      "expected_liquidation_price": "105.0",
      "expected_bankruptcy_price": "110.0"
    },
    {
      "description": "High leverage long",
      "entry_price": "50000.0",
      "size": "1.0",
      "deposit": "2500.0",
      "type": "Long",
      "maintenance_margin": "0.005",
      "expected_liquidation_price": "47750.0",
      "expected_bankruptcy_price": "47500.0"
    },
    {
      "description": "Near liquidation long",
      "entry_price": "100.0",
      "size": "10.0",
      "deposit": "50.0",
      "type": "Long",
      "maintenance_margin": "0.05",
      "expected_liquidation_price": "100.0",
      "expected_bankruptcy_price": "95.0"
    }
  ],
  
  "numeric_precision_cases": [
    {
      "description": "UD64 precision",
      "type": "UD64",
      "input": "123456.789012345",
      "expected_precision_digits": 9
    },
    {
      "description": "UD128 precision",
      "type": "UD128",
      "input": "123456789012345678.901234567890123456",
      "expected_precision_digits": 18
    },
    {
      "description": "D256 negative precision",
      "type": "D256",
      "input": "-999999999999999999.999999999999999999",
      "expected_precision_digits": 18
    }
  ],
  
